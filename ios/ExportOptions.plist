<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store Connect / TestFlight export. Use once an Apple Distribution
	     certificate exists in the keychain:
	       flutter build ipa --release --export-options-plist=ios/ExportOptions.plist
	     then upload the .ipa with Transporter.app or:
	       xcrun altool --upload-app -t ios -f build/ios/ipa/*.ipa \
	         -u <apple-id> -p <app-specific-password>
	-->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>8D2BG3498Y</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<key>destination</key>
	<string>export</string>
	<!-- Keep the build number pubspec.yaml set. Left to its default (true), the
	     export asks App Store Connect and silently renumbers the IPA past the
	     highest build there, so CFBundleVersion stops matching the in-app badge. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
