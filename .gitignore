**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# AI assistant instruction files — local-only tooling, not for public consumption.
CLAUDE.md
GEMINI.md
.claude/
.gemini/

# Icon working directory — iteration drafts (AppIcon0.png, AppIcon1.png, …)
# that aren't the canonical source. The canonical source is
# assets/icons/app_icon_source.png; everything else stays local.
/icons/

# App Store screenshots — captured locally, uploaded to App Store Connect by hand.
/app_store/

# Local working docs — kept out of the public repo.
/docs/

# Kokoro Core ML weights + voices (234 MB) — built by ios/get-kokoro-coreml.sh.
# MUST mirror the same rules in -closed/.gitignore. Without them the weights are
# untracked-but-not-ignored in -open, and one `git add` of the asset directory
# commits a quarter-gigabyte of regenerable model data into a public repo.
ios/Runner/KokoroAssets/*
# ...except the pre-rendered clips: 5.2 MB, and they ARE the app's voice. A
# clone without them cannot speak, so they are product, not a regenerable render.
!ios/Runner/KokoroAssets/KokoroClips/
